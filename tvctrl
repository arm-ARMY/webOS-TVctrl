# --- MODULE 6: BACKLIGHT ---
cmd_backlight() {
    STATUS=$(luna-send -n 1 -w 1000 luna://com.webos.settingsservice/getSystemSettings '{"category": "picture", "keys": ["backlight"]}' 2>/dev/null)
    BL=$(echo "$STATUS" | sed -n 's/.*"backlight":\([0-9]*\).*/\1/p')
    printf "\n%b Backlight is now set to: %s%%\n\n" "$INFO" "$BL"

    while true; do
        printf "%b Enter backlight value (0-100) or 'q' to back: " "$ASK"
        read -r val
        printf "\n"
        if [ "$val" = "q" ] || [ "$val" = "Q" ]; then
            printf "\n"
            break
        elif echo "$val" | grep -qE '^[0-9]+$' && [ "$val" -ge 0 ] && [ "$val" -le 100 ]; then
            luna-send -n 1 -f luna://com.webos.settingsservice/setSystemSettings '{"category": "picture", "settings": {"backlight": '"$val"'}}' > /dev/null 2>&1
            printf "%b Backlight set to %s%%\n\n" "$OK" "$val"
            break
        else
            printf "%b Invalid value. Enter 0-100 or 'q'.\n\n" "$ERR"
        fi
    done
}

# --- HELPER: READ CURRENT PICTURE PARAMETER ---
get_picture_setting() {
    KEY="$1"
    LABEL="$2"
    UNIT="$3"

    STATUS=$(luna-send -n 1 -w 1000 luna://com.webos.settingsservice/getSystemSettings "{\"category\": \"picture\", \"keys\": [\"$KEY\"]}" 2>/dev/null)

    SETTINGS_PART=$(echo "$STATUS" | sed -n 's/.*"settings":{\(.*\)}.*/\1/p')
    VAL=$(echo "$SETTINGS_PART" | sed -n "s/.*\"$KEY\":[\"]*\\([^\",}]*\\)[\"]*.*/\1/p")

    if [ -n "$VAL" ]; then
        printf "\n%b Current %s: %s%s\n" "$OK" "$LABEL" "$VAL" "$UNIT"
    else
        printf "\n%b Could not read %s.\n" "$ERR" "$LABEL"
    fi
}

