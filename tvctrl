# --- MODULE 16: SCREEN SAVER ---
cmd_screensaver() {
    printf "\n%b Starting Screen Saver...\n\n" "$INFO"
    sleep 3
    printf "%b Screen Saver ON\n\n" "$OK"
    sleep 3

    PREV_APP=$(luna-send -n 1 -w 1000 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null \
        | sed -n 's/.*"appId":"\([^"]*\)".*/\1/p')

    if [ -z "$PREV_APP" ] || [ "$PREV_APP" = "com.webos.app.screensaver" ]; then
        PREV_APP="com.webos.app.hdmi1"
    fi

    luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.screensaver"}' > /dev/null 2>&1

    printf "%b Press Enter to return to %s..." "$ASK" "$PREV_APP"
    read -r _

    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "com.webos.app.screensaver"}' > /dev/null 2>&1
    luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$PREV_APP\"}" > /dev/null 2>&1

    printf "\n%b Screen Saver OFF\n\n" "$WARN"
}

# --- MODULE 17: REAL-TIME REMOTE KEYS (TOGGLE SAVER 's', ENTER TO EXIT, VOL +-1) ---
cmd_realtime_keys() {
    OLD_STTY=$(stty -g 2>/dev/null)
    trap 'stty "$OLD_STTY" 2>/dev/null; trap - INT TERM EXIT' INT TERM EXIT
    stty -icanon -echo 2>/dev/null

    SAVER_ON=0
    SAVER_PREV_APP="com.webos.app.hdmi1"

    printf "\n%b Real-Time Remote Keys active\n\n" "$OK"
    printf "%b [+/-] Vol +-1 | [m] Mute | [h] HDMI 1 | [2] HDMI 2 | [l] LG Channels\n" "$INFO"
    printf "%b [y] YouTube  | [b] Browser | [u] USB | [c] Control Panel | [s] ScreenSaver ON/OFF\n" "$INFO"
    printf "%b [o] Screen ON   | [f] Screen OFF | [Enter/q] Back to Menu\n\n" "$INFO"

    while true; do
        c=$(dd bs=1 count=1 2>/dev/null)
        case "$c" in
            ""|"
"|"
")
                if [ "$SAVER_ON" -eq 1 ]; then
                    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "com.webos.app.screensaver"}' > /dev/null 2>&1
                    luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$SAVER_PREV_APP\"}" > /dev/null 2>&1
                    SAVER_ON=0
                fi
                break
                ;;
            +)
                CUR=$(luna-send -n 1 -w 1000 luna://com.webos.audio/getVolume '{}' 2>/dev/null | sed -n 's/.*"volume":\([0-9]*\).*/\1/p')
                [ -z "$CUR" ] && CUR=10
                NV=$((CUR + 1)); [ "$NV" -gt 100 ] && NV=100
                luna-send -n 1 -f luna://com.webos.audio/setMuted '{"muted": false}' > /dev/null 2>&1
                luna-send -n 1 -f luna://com.webos.audio/setVolume "{\"volume\": $NV}" > /dev/null 2>&1
                printf "%b Volume -> %s%%\n" "$OK" "$NV"
                ;;
            -)
                CUR=$(luna-send -n 1 -w 1000 luna://com.webos.audio/getVolume '{}' 2>/dev/null | sed -n 's/.*"volume":\([0-9]*\).*/\1/p')
                [ -z "$CUR" ] && CUR=10
                NV=$((CUR - 1)); [ "$NV" -lt 0 ] && NV=0
                luna-send -n 1 -f luna://com.webos.audio/setMuted '{"muted": false}' > /dev/null 2>&1
                luna-send -n 1 -f luna://com.webos.audio/setVolume "{\"volume\": $NV}" > /dev/null 2>&1
                printf "%b Volume -> %s%%\n" "$OK" "$NV"
                ;;
            m|M)
                MUT=$(luna-send -n 1 -w 1000 luna://com.webos.audio/getVolume '{}' 2>/dev/null | sed -n 's/.*"muteStatus":\([a-z]*\).*/\1/p')
                if [ "$MUT" = "true" ]; then
                    luna-send -n 1 -f luna://com.webos.audio/setMuted '{"muted": false}' > /dev/null 2>&1
                    printf "%b Unmuted\n" "$OK"
                else
                    luna-send -n 1 -f luna://com.webos.audio/setMuted '{"muted": true}' > /dev/null 2>&1
                    printf "%b TV Muted\n" "$WARN"
                fi
                ;;
            h|H)
                luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.hdmi1"}' > /dev/null 2>&1
                printf "%b Input -> HDMI 1\n" "$OK"
                ;;
            2)
                luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.hdmi2"}' > /dev/null 2>&1
                printf "%b Input -> HDMI 2\n" "$OK"
                ;;
            l|L)
                luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.lgchannels"}' > /dev/null 2>&1
                printf "%b App -> LG Channels\n" "$OK"
                ;;
            y|Y)
                luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "youtube.leanback.v4"}' > /dev/null 2>&1
                printf "%b App -> YouTube\n" "$OK"
                ;;
            b|B)
                luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.browser"}' > /dev/null 2>&1
                printf "%b App -> Web Browser\n" "$OK"
                ;;
            u|U)
                luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.mediadiscovery", "params": {"target": "/tmp/usb/sda/sda1"}}' > /dev/null 2>&1
                printf "%b Input -> USB Storage\n" "$OK"
                ;;
            c|C)
                luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.homeconnect"}' > /dev/null 2>&1
                printf "%b App -> Control Panel\n" "$OK"
                ;;
            s|S)
                if [ "$SAVER_ON" -eq 0 ]; then
                    FG_NOW=$(luna-send -n 1 -w 1000 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null \
                        | sed -n 's/.*"appId":"\([^"]*\)".*/\1/p')
                    if [ -n "$FG_NOW" ] && [ "$FG_NOW" != "com.webos.app.screensaver" ]; then
                        SAVER_PREV_APP="$FG_NOW"
                    else
                        SAVER_PREV_APP="com.webos.app.hdmi1"
                    fi
                    luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.screensaver"}' > /dev/null 2>&1
                    SAVER_ON=1
                    printf "%b Screen Saver ON (return -> %s)\n" "$OK" "$SAVER_PREV_APP"
                else
                    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "com.webos.app.screensaver"}' > /dev/null 2>&1
                    luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$SAVER_PREV_APP\"}" > /dev/null 2>&1
                    SAVER_ON=0
                    printf "%b Screen Saver OFF (returned to %s)\n" "$WARN" "$SAVER_PREV_APP"
                fi
                ;;
            o|O)
                luna-send -n 1 -f luna://com.webos.service.tvpower/power/turnOnScreen '{}' > /dev/null 2>&1
                printf "%b Monitor set ON\n" "$OK"
                ;;
            f|F)
                luna-send -n 1 -f luna://com.webos.service.tvpower/power/turnOffScreen '{}' > /dev/null 2>&1
                printf "%b Monitor set OFF\n" "$WARN"
                ;;
            q|Q)
                if [ "$SAVER_ON" -eq 1 ]; then
                    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "com.webos.app.screensaver"}' > /dev/null 2>&1
                    luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$SAVER_PREV_APP\"}" > /dev/null 2>&1
                    SAVER_ON=0
                fi
                break
                ;;
        esac
    done

    stty "$OLD_STTY" 2>/dev/null
    trap - INT TERM EXIT
   #printf "\n%b Real-Time Remote Keys stopped.\n\n" "$INFO"
    printf "%b Real-Time Remote Keys stopped.\n\n" "$INFO"
}

# --- MODULE 11: IR SENSOR CAPTURE (RAW HEXADECIMAL - OPTION 7) ---
cmd_capture_ir() {
    echo
    pkill -f "dd if=/dev/input/event1" 2>/dev/null
    printf "%b Starting to capture raw hexadecimal IR remote control info\n\n" "$OK"
    printf "%b Press Enter to stop and return to menu...\n\n" "$INFO"

    hexdump -C /dev/input/event1 &
    HEX_PID=$!

    read -r _

    kill "$HEX_PID" 2>/dev/null
    wait "$HEX_PID" 2>/dev/null
    printf "\n\n"
}

# --- MODULE 12: REAL-TIME IR TRANSLATOR (OPTION 8) ---
cmd_realtime_ir() {
    echo
    pkill -f "dd if=/dev/input/event1" 2>/dev/null
    printf "%b Real Time IR Translator started\n" "$OK"
    echo
    printf "%b Press Enter to stop and return to menu...\n" "$INFO"
    echo

    (
        while true; do
            dd if=/dev/input/event1 bs=24 count=1 2>/dev/null | hexdump -C | awk '{
                if (NF >= 17 && $10 == "01" && $11 == "00") {
                    code = $13 $12;
                    if ($14 == "01") {
                        name = "Unknown (0x" code ")";
                        if (code == "0072") name = "Volume Down (-)";
                        else if (code == "0073") name = "Volume Up (+)";
                        else if (code == "0071") name = "Mute";
                        else if (code == "0067") name = "Arrow Up (^)";
                        else if (code == "006c") name = "Arrow Down (v)";
                        else if (code == "0069") name = "Arrow Left (<)";
                        else if (code == "006a") name = "Arrow Right (>)";
                        else if (code == "001c") name = "Enter / OK";
                        else if (code == "019c") name = "Back";
                        else if (code == "000b") name = "Button 0";
                        else if (code == "0002") name = "Button 1";
                        else if (code == "0003") name = "Button 2";
                        else if (code == "0004") name = "Button 3";
                        else if (code == "0005") name = "Button 4";
                        else if (code == "0006") name = "Button 5";
                        else if (code == "0007") name = "Button 6";
                        else if (code == "0008") name = "Button 7";
                        else if (code == "0009") name = "Button 8";
                        else if (code == "000a") name = "Button 9";
                        else if (code == "00d9") name = "Search";
                        else if (code == "0305") name = "Home";
                        else if (code == "0192") name = "Channel Up (^)";
                        else if (code == "0193") name = "Channel Down (v)";
                        else if (code == "03e2") name = "More";
                        else if (code == "040e") name = "Prime Video";
                        else if (code == "040d") name = "Netflix";
                        else if (code == "0415") name = "Globo Play";
                        else if (code == "0412") name = "Disney";
                        else if (code == "008b") name = "Settings";
                        else if (code == "00f1") name = "Input";
                        else if (code == "016a") name = "Guide";
                        else if (code == "00a8") name = "Rewind";
                        else if (code == "00cf") name = "Play";
                        else if (code == "0077") name = "Pause";
                        else if (code == "00d0") name = "Forward";
                        else if (code == "00a7") name = "Rec";
                        else if (code == "018f") name = "Green Button";
                        else if (code == "0190") name = "Yellow Button";
                        else if (code == "0191") name = "Blue Button";
                        else if (code == "018e") name = "Red Button";
                        else if (code == "0080") name = "Live Playback";
                        else if (code == "0303") name = "Channels";
                        else if (code == "033d") name = "SAP";
                        else if (code == "0166") name = "Info";
                        else if (code == "045c") name = "LG Channels";

                        print "[Pressed] -> " name " (Code: 0x" code ")";
                        fflush();
                    }
                }
            }'
        done
    ) &
    LOOP_PID=$!

    read -r _

    kill "$LOOP_PID" 2>/dev/null
    pkill -P "$LOOP_PID" 2>/dev/null
    wait "$LOOP_PID" 2>/dev/null
    printf "\n\n"
}

# --- MODULE 13: GATHER INFORMATION (STATUS AND INFO) ---
cmd_info_menu() {
    while true; do
        print_banner
        printf "  \033[1;33m=== GATHER INFORMATION ===\033[0m\n\n"
        printf "  \033[1;37m1)\033[0m Check Volume & Mute Status\n"
        printf "  \033[1;37m2)\033[0m Check Picture Settings\n"
        printf "  \033[1;37m3)\033[0m Get Device & System Info\n"
        printf "  \033[1;37m4)\033[0m List Installed Apps\n"
        printf "  \033[1;37m5)\033[0m Foreground App (Running Now)\n"
        printf "  \033[1;37m6)\033[0m Background Apps\n"
        printf "  \033[1;37m7)\033[0m Capture IR Raw Hex (event1)\n"
        printf "  \033[1;37m8)\033[0m Real Time IR Translator\n"
        printf "  \033[1;31m0)\033[0m Back to Main Menu\n\n"
        printf "%b Select an option: " "$ASK"
        read -r infopt

        case "$infopt" in
            1)
                printf "\n%b Fetching Volume Status...\n" "$INFO"
                echo
                STATUS=$(luna-send -n 1 -w 1000 luna://com.webos.audio/getVolume '{}' 2>/dev/null)
                VOL=$(echo "$STATUS" | sed -n 's/.*"volume":\([0-9]*\).*/\1/p')
                MUTED=$(echo "$STATUS" | sed -n 's/.*"muteStatus":\([a-z]*\).*/\1/p')
                if [ "$MUTED" = "true" ]; then
                    printf "%b Volume: %s%% \033[1;31m(Muted)\033[0m\n" "$INFO" "$VOL"
                else
                    printf "%b Volume: %s%%\n" "$OK" "$VOL"
                fi
                printf "\n%b Press Enter to continue..." "$INFO"; read -r _
                ;;
            2)
                cmd_check_picture_menu
                ;;
            3)
                printf "\n"
                uname -a
                printf "\n"
                lsb_release -a 2>/dev/null
                printf "\n\033[1;5m[i] This is your webOS version\033[0m\n\n"
                luna-send -n 1 luna://com.webos.service.tv.systemproperty/getSystemInfo '{"keys": ["modelName", "firmwareVersion", "sdkVersion"]}'
                printf "\n%b Press Enter to continue..." "$INFO"; read -r _
                ;;
            4)
                printf "\n%b Installed Applications (Title & ID):\n\n" "$INFO"
                luna-send -n 1 -f luna://com.webos.applicationManager/listApps '{}' 2>/dev/null \
                    | grep -E '"id":|"title":' \
                    | sed 's/^[ \t]*//' \
                    | sed '/"id":/G'
                printf "%b Press Enter to continue..." "$INFO"; read -r _
                ;;
            5)
                printf "\n%b This App is running now...\n\n" "$INFO"
                sleep 1
                luna-send -n 1 -f luna://com.webos.applicationManager/getForegroundAppInfo '{}'
                printf "\n%b Press Enter to continue..." "$INFO"; read -r _
                ;;
            6)
                printf "\n%b These Apps are in background...\n\n" "$INFO"
                sleep 1
                luna-send -n 1 -f luna://com.webos.applicationManager/running '{}'
                printf "\n%b Press Enter to continue..." "$INFO"; read -r _
                ;;
            7)
                cmd_capture_ir
                ;;
            8)
                cmd_realtime_ir
                ;;
            0) break ;;
            *) printf "\n%b Invalid option.\n" "$ERR"; sleep 1 ;;
        esac
    done
}

# --- MODULE 14: SEND REMOTE COMMANDS (COMMANDS MENU) ---
cmd_remote_menu() {
    while true; do
        print_banner
        printf "  \033[1;33m=== SEND REMOTE COMMANDS ===\033[0m\n\n"
        printf "  \033[1;37m1)\033[0m Volume Control\n"
