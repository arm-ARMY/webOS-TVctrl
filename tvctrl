#!/bin/sh

# Standardized colors and prefixes
INFO="\033[1;37m[i]\033[0m"
ASK="\033[1;33m[?]\033[0m"
OK="\033[1;32m[*]\033[0m"
WARN="\033[1;31m[*]\033[0m"
ERR="\033[1;31m[!]\033[0m"

print_banner() {
    clear
    printf "\033[1;32m"
    cat << 'EOF'
               __   ____  ____
   _    _____ / /  / __ \/ __/
  | |/|/ / -_) _ \/ /_/ /\ \  
  |__,__/\__/_.__/\____/___/  
   _______   __    __      __ 
  /_  __/ | / /___/ /_____/ / 
   / /  | |/ / __/ __/ __/ / 
  /_/   |___/\__/\__/_/ /_/  
EOF
    printf "\033[0m\n"
}

# --- MODULE 1: VOLUME ---
cmd_vol() {
    printf "\n%b Volume is now set to:\n\n" "$INFO"

    STATUS=$(luna-send -n 1 -w 1000 luna://com.webos.audio/getVolume '{}' 2>/dev/null)
    VOL=$(echo "$STATUS" | sed -n 's/.*"volume":\([0-9]*\).*/\1/p')
    MUTED=$(echo "$STATUS" | sed -n 's/.*"muteStatus":\([a-z]*\).*/\1/p')

    if [ "$MUTED" = "true" ]; then
        printf "\033[1;31m(Muted)\033[0m\n\n"
    else
        printf "%s%%\n\n" "$VOL"
    fi

    while true; do
        printf "%b Enter volume value (0-100), 'm' to mute, or 'q' to back: " "$ASK"
        read -r value
        printf "\n"

        if [ "$value" = "q" ] || [ "$value" = "Q" ]; then
            break
        elif [ "$value" = "m" ] || [ "$value" = "M" ]; then
            luna-send -n 1 -f luna://com.webos.audio/setMuted '{"muted": true}' > /dev/null 2>&1
            printf "%b TV Muted\n\n" "$WARN"
            break
        elif echo "$value" | grep -qE '^[0-9]+$' && [ "$value" -ge 0 ] && [ "$value" -le 100 ]; then
            luna-send -n 1 -f luna://com.webos.audio/setMuted '{"muted": false}' > /dev/null 2>&1
            luna-send -n 1 -f luna://com.webos.audio/setVolume '{"volume": '"$value"'}' > /dev/null 2>&1
            printf "%b Volume set to %s%%\n\n" "$OK" "$value"
            break
        else
            printf "%b Invalid value. Enter 0-100, 'm', or 'q'.\n\n" "$ERR"
        fi
    done
}

# --- MODULE 2: YOUTUBE (WITH RETURN AND RAM CLEANUP) ---
cmd_yt() {
    PREV_APP=$(luna-send -n 1 -w 1000 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null \
        | sed -n 's/.*"appId":"\([^"]*\)".*/\1/p')

    if [ -z "$PREV_APP" ] || [ "$PREV_APP" = "youtube.leanback.v4" ]; then
        PREV_APP="com.webos.app.hdmi1"
    fi

    URL="$1"
    if [ -z "$URL" ]; then
        printf "\n%b Paste YouTube URL (or press Enter for Home): " "$ASK"
        read -r URL
    fi

    printf "\n%b Opening YouTube ad free...\n\n" "$INFO"
    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "youtube.leanback.v4"}' > /dev/null 2>&1
    sleep 1

    if [ -n "$URL" ]; then
        TARGET_URL=$(echo "$URL" | cut -d'&' -f1)
        printf "%b Loading video: %s\n\n" "$INFO" "$TARGET_URL"
        luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"youtube.leanback.v4\", \"params\": {\"contentTarget\": \"$TARGET_URL\"}}" > /dev/null 2>&1
    else
        printf "%b No link provided. Opening app home screen...\n\n" "$INFO"
        luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "youtube.leanback.v4"}' > /dev/null 2>&1
    fi

    printf "%b Press Enter when done to close YouTube and return to %s..." "$ASK" "$PREV_APP"
    read -r _
    
    printf "\n%b Closing YouTube to free RAM...\n" "$INFO"
    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "youtube.leanback.v4"}' > /dev/null 2>&1
    
    printf "%b Returning to %s...\n\n" "$INFO" "$PREV_APP"
    luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$PREV_APP\"}" > /dev/null 2>&1
}

# --- MODULE 3: LIVE TV (WITH RETURN TO PREVIOUS INPUT - CLI SHORTCUT) ---
