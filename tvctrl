        luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"com.webos.app.browser\", \"params\": {\"target\": \"$URL\"}}" > /dev/null 2>&1
    else
        printf "%b No link provided. Opening browser home screen...\n\n" "$INFO"
        luna-send -n 1 -f luna://com.webos.applicationManager/launch '{"id": "com.webos.app.browser"}' > /dev/null 2>&1
    fi

    printf "%b Press Enter when done to close Browser and return to %s..." "$ASK" "$PREV_APP"
    read -r _
    
    printf "\n%b Closing Web Browser to free RAM...\n" "$INFO"
    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "com.webos.app.browser"}' > /dev/null 2>&1
    
    printf "\n%b Returning to %s...\n\n" "$INFO" "$PREV_APP"
    luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$PREV_APP\"}" > /dev/null 2>&1
}

# --- HELPER: SWITCH INPUT/APP AND WAIT FOR ENTER TO RETURN ---
switch_input_with_return() {
    TARGET_ID="$1"
    TARGET_PARAMS="$2"
    LABEL="$3"

    PREV_APP=$(luna-send -n 1 -w 1000 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null \
        | sed -n 's/.*"appId":"\([^"]*\)".*/\1/p')

    if [ -z "$PREV_APP" ] || [ "$PREV_APP" = "$TARGET_ID" ]; then
        PREV_APP="com.webos.app.hdmi1"
    fi

    printf "\n%b Set Input/Source to:\n\n" "$INFO"
    sleep 1
    printf "%b %s\n\n" "$OK" "$LABEL"
    sleep 3

    if [ -n "$TARGET_PARAMS" ]; then
        luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$TARGET_ID\", \"params\": $TARGET_PARAMS}" > /dev/null 2>&1
    else
        luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$TARGET_ID\"}" > /dev/null 2>&1
    fi

    printf "%b Press Enter when done to return to %s..." "$ASK" "$PREV_APP"
    read -r _

    printf "\n%b Returning to %s...\n\n" "$INFO" "$PREV_APP"
    luna-send -n 1 -f luna://com.webos.applicationManager/launch "{\"id\": \"$PREV_APP\"}" > /dev/null 2>&1
}

