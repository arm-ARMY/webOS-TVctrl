# --- GENERIC PICTURE ADJUSTMENT FUNCTION (0-100) ---
set_picture_setting() {
    KEY="$1"
    LABEL="$2"

    STATUS=$(luna-send -n 1 -w 1000 luna://com.webos.settingsservice/getSystemSettings "{\"category\": \"picture\", \"keys\": [\"$KEY\"]}" 2>/dev/null)
    VAL=$(echo "$STATUS" | sed -n "s/.*\"$KEY\":\([0-9]*\).*/\1/p")
    printf "\n%b Current %s: %s%%\n\n" "$INFO" "$LABEL" "$VAL"

    while true; do
        printf "%b Enter new %s value (0-100) or 'q' to back: " "$ASK" "$LABEL"
        read -r val
        printf "\n"
        if [ "$val" = "q" ] || [ "$val" = "Q" ]; then
            break
        elif echo "$val" | grep -qE '^[0-9]+$' && [ "$val" -ge 0 ] && [ "$val" -le 100 ]; then
            luna-send -n 1 -f luna://com.webos.settingsservice/setSystemSettings "{\"category\": \"picture\", \"settings\": {\"$KEY\": $val}}" > /dev/null 2>&1
            printf "%b %s set to %s%%\n\n" "$OK" "$LABEL" "$val"
            break
        else
            printf "%b Invalid value. Enter 0-100 or 'q'.\n\n" "$ERR"
        fi
    done
