        printf "  \033[1;37m5)\033[0m Screen OFF\n"
        printf "  \033[1;37m6)\033[0m Take Screenshot\n"
        printf "  \033[1;37m7)\033[0m Send Modal Alert\n"
        printf "  \033[1;37m8)\033[0m Send Toast Pop-up\n"
        printf "  \033[1;37m9)\033[0m Open Web Browser\n"
        printf "  \033[1;37m10)\033[0m Switch Input/Source\n"
        printf "  \033[1;37m11)\033[0m Screen Saver\n"
        printf "  \033[1;37m12)\033[0m Send Real-Time Remote Keys\n"
        printf "  \033[1;31m0)\033[0m Back to Main Menu\n\n"
        printf "%b Select an option: " "$ASK"
        read -r remopt

        case "$remopt" in
            1) cmd_vol; printf "%b Press Enter to continue..." "$INFO"; read -r _ ;;
            2) cmd_picture_menu ;;
            3) cmd_yt ;;
            4) cmd_screen_on; printf "%b Press Enter to continue..." "$INFO"; read -r _ ;;
            5) cmd_screen_off; printf "%b Press Enter to continue..." "$INFO"; read -r _ ;;
            6) cmd_screenshot; printf "%b Press Enter to continue..." "$INFO"; read -r _ ;;
            7) cmd_tvmsg; printf "%b Press Enter to continue..." "$INFO"; read -r _ ;;
            8) cmd_tvpu; printf "%b Press Enter to continue..." "$INFO"; read -r _ ;;
            9) cmd_browser ;;
            10) cmd_input_menu ;;
            11) cmd_screensaver; printf "%b Press Enter to continue..." "$INFO"; read -r _ ;;
            12) cmd_realtime_keys ;;
            0) break ;;
            *) printf "\n%b Invalid option.\n" "$ERR"; sleep 1 ;;
        esac
    done
}

# --- CLI HELP (--help / -h) ---
cmd_help() {
    printf "\nwebOS TVctrl - Remote Control & Diagnostics CLI\n\n"
    printf "Usage:\n"
    printf "  tvctrl                    Open interactive menu\n"
    printf "  tvctrl <command> [arg]    Run a command directly\n"
    printf "  tvctrl --help | -h        Show this help message\n\n"

    printf "Commands:\n"
    printf "  vol                       Volume control (0-100, mute, back)\n"
    printf "  yt [url]                  Open YouTube ad-free (optional URL)\n"
    printf "  tv | livetv               Switch to Live TV with return\n"
    printf "  on | off                  Turn TV screen ON or OFF\n"
    printf "  bl                        Adjust picture backlight (0-100)\n"
    printf "  scc                       Take screenshot and restore picture settings\n"
    printf "  msg                       Send modal alert with OK button\n"
    printf "  pu                        Send toast pop-up notification\n"
    printf "  browser [url]             Open Web Browser (optional URL)\n"
    printf "  cpanel | lgchan           Open Control Panel or LG Channels\n"
    printf "  hdmi1 | hdmi2 | media     Switch to HDMI 1, HDMI 2, or USB storage\n"
    printf "  saver | ss                Toggle Screen Saver with return\n"
    printf "  keys | rt                 Real-time remote keys via keyboard\n"
    printf "  ir | capture              Capture raw IR hex from /dev/input/event1\n"
    printf "  translate | realtime      Real-time IR key translator\n"
    printf "  apps | fg | bg            List apps, foreground app, or running apps\n\n"
}

# --- DIRECT CLI ARGUMENT SUPPORT ---
if [ -n "$1" ]; then
    case "$1" in
        --help|-h|help) cmd_help; exit 0 ;;
        vol) cmd_vol; exit 0 ;;
        yt) cmd_yt "$2"; exit 0 ;;
        tv|livetv) cmd_livetv; exit 0 ;;
        on) cmd_screen_on; exit 0 ;;
        off) cmd_screen_off; exit 0 ;;
        bl) cmd_backlight; exit 0 ;;
        scc) cmd_screenshot; exit 0 ;;
        msg) cmd_tvmsg; exit 0 ;;
        pu) cmd_tvpu; exit 0 ;;
        browser) cmd_browser "$2"; exit 0 ;;
        input) cmd_input_menu; exit 0 ;;
        cpanel) cmd_cpanel; exit 0 ;;
        lgchan) cmd_lgchan; exit 0 ;;
        hdmi1) cmd_hdmi1; exit 0 ;;
        hdmi2) cmd_hdmi2; exit 0 ;;
        media) cmd_media; exit 0 ;;
        saver|ss) cmd_screensaver; exit 0 ;;
        keys|rt) cmd_realtime_keys; exit 0 ;;
        ir|capture) cmd_capture_ir; exit 0 ;;
        translate|realtime) cmd_realtime_ir; exit 0 ;;
        apps) 
            luna-send -n 1 -f luna://com.webos.applicationManager/listApps '{}' 2>/dev/null \
                | grep -E '"id":|"title":' \
                | sed 's/^[ \t]*//' \
                | sed '/"id":/G'
            exit 0 
            ;;
        fg)
            luna-send -n 1 -f luna://com.webos.applicationManager/getForegroundAppInfo '{}'
            printf "\n"
            exit 0
            ;;
        bg)
            luna-send -n 1 -f luna://com.webos.applicationManager/running '{}'
            printf "\n"
            exit 0
            ;;
        *)
            printf "\n%b Unknown command: %s\n" "$ERR" "$1"
            printf "%b Run 'tvctrl --help' to see available commands.\n\n" "$INFO"
            exit 1
            ;;
    esac
fi

