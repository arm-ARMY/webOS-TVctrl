        | sed -n 's/.*"appId":"\([^"]*\)".*/\1/p')

    if [ -z "$PREV_APP" ] || [ "$PREV_APP" = "com.webos.app.livetv" ]; then
        PREV_APP="com.webos.app.hdmi1"
    fi

