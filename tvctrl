# --- MODULE 7: SCREENSHOT (SCC WITH TEMPORARY PICTURE ADJUSTMENT) ---
cmd_screenshot() {
    CAP_DIR="/home/root/Apps/ScreenCap"
    mkdir -p "$CAP_DIR"

    PIC_STATUS=$(luna-send -n 1 -w 1000 luna://com.webos.settingsservice/getSystemSettings '{"category": "picture", "keys": ["brightness", "backlight", "contrast"]}' 2>/dev/null)
    SETTINGS_PART=$(echo "$PIC_STATUS" | sed -n 's/.*"settings":{\(.*\)}.*/\1/p')
    ORIG_BR=$(echo "$SETTINGS_PART" | sed -n 's/.*"brightness":["]*\([^",}]*\)["]*.*/\1/p')
    ORIG_BL=$(echo "$SETTINGS_PART" | sed -n 's/.*"backlight":["]*\([^",}]*\)["]*.*/\1/p')
    ORIG_CT=$(echo "$SETTINGS_PART" | sed -n 's/.*"contrast":["]*\([^",}]*\)["]*.*/\1/p')

    printf "\n%b Boosting Brightness (80%%), Backlight (70%%) and Contrast (85%%) for capture...\n" "$INFO"
    luna-send -n 1 -f luna://com.webos.settingsservice/setSystemSettings '{"category": "picture", "settings": {"brightness": 80, "backlight": 70, "contrast": 85}}' > /dev/null 2>&1
    sleep 2

    printf "%b Taking a screenshot...\n\n" "$INFO"
    luna-send -n 1 -f 'luna://com.webos.service.capture/executeOneShot' '{"path":"/home/root/Apps/ScreenCap/screenshot.png","method":"DISPLAY","format":"PNG"}' > /dev/null 2>&1
    sleep 1

    mv "$CAP_DIR/screenshot.png" "$CAP_DIR/scc_$(date +%Y%m%d_%H%M%S).png" 2> /dev/null

    if [ -n "$ORIG_BR" ] && [ -n "$ORIG_BL" ] && [ -n "$ORIG_CT" ]; then
        luna-send -n 1 -f luna://com.webos.settingsservice/setSystemSettings "{\"category\": \"picture\", \"settings\": {\"brightness\": $ORIG_BR, \"backlight\": $ORIG_BL, \"contrast\": $ORIG_CT}}" > /dev/null 2>&1
        printf "%b Restored Brightness (%s%%), Backlight (%s%%) and Contrast (%s%%)\n" "$INFO" "$ORIG_BR" "$ORIG_BL" "$ORIG_CT"
    fi

    printf "%b File stored at %s/\n\n" "$OK" "$CAP_DIR"
}

# --- MODULE 8: TV ALERT MESSAGE (TVMSG) ---
cmd_tvmsg() {
    printf "\n%b Message system alert\n" "$INFO"
    echo
    printf "%b Enter the message to display on screen: " "$ASK"
    read -r ENTRADA

    if [ -z "$ENTRADA" ]; then
        printf "\n%b No message entered. Operation aborted.\n\n" "$ERR"
        return
    fi

    printf "\n%b Sending alert to the TV screen...\n" "$INFO"
    echo
    sleep 1
    luna-send -n 1 -f luna://com.webos.notification/createAlert "{\"buttons\":[{\"label\":\"OK\"}], \"message\": \"$ENTRADA\"}" > /dev/null 2>&1

    printf "%b The alert will remain until the OK button is pressed.\n\n" "$OK"
}

