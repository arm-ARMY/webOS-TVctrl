while true; do
    print_banner
    printf "\n"
    printf "  \033[1;37m1)\033[0m Gather Information\n"
    printf "  \033[1;37m2)\033[0m Send Remote Commands\n"
    printf "  \033[1;31m0)\033[0m Quit\n\n"
    printf "%b Select an option: " "$ASK"
    read -r mainopt

    case "$mainopt" in
        1) cmd_info_menu ;;
        2) cmd_remote_menu ;;
        0|q|Q) printf "\n%b Exiting webOS TVctrl...\n\n" "$INFO"; exit 0 ;;
        *) printf "\n%b Invalid option.\n" "$ERR"; sleep 1 ;;
    esac
done
