        | sed -n 's/.*"appId":"\([^"]*\)".*/\1/p')

    if [ -z "$PREV_APP" ] || [ "$PREV_APP" = "com.webos.app.browser" ]; then
        PREV_APP="com.webos.app.hdmi1"
    fi

    URL="$1"
    if [ -z "$URL" ]; then
        printf "\n%b Paste Website URL (or press Enter for Home): " "$ASK"
        read -r URL
    fi

    printf "\n%b Opening Web Browser...\n\n" "$INFO"
    luna-send -n 1 -f luna://com.webos.applicationManager/closeByAppId '{"id": "com.webos.app.browser"}' > /dev/null 2>&1
    sleep 1

    if [ -n "$URL" ]; then
